{
  "name": "thai-assessment",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "npm.cmd --prefix server run dev",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test server/fixes.test.js server/auth-role.test.js tests/question-navigation.test.mjs tests/speech-recognition.test.mjs tests/admin-summary.test.mjs tests/dashboard-view.test.mjs tests/recorded-speaking.test.mjs tests/audio-recording.test.mjs tests/uuid.test.mjs tests/address-helper.test.mjs tests/csv-export.test.mjs tests/name-prefix.test.mjs",
    "test:integration": "node --env-file=server/.env server/mongo-api.test.js"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "gtts": "^0.2.1",
    "puppeteer": "^25.3.0",
    "vite": "^8.0.1",
    "vite-plugin-pwa": "^1.3.0"
  }
